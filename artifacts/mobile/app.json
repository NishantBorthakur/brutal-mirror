{
  "expo": {
    "name": "Brutal Mirror",
    "slug": "brutal-mirror",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brutalmirror",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.orami.brutalmirror"
    },
    "android": {
      "package": "com.orami.brutalmirror",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://brutal-ai-web.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withAndroidSigning",
      "./plugins/withRemovePermissions"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "bd7a6992-d69b-4278-975f-75f9aac7ca95"
      }
    }
  }
}
