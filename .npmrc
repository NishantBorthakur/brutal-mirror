auto-install-peers=false
strict-peer-dependencies=false
confirm-modules-purge=false

# Hoist Expo and React Native packages to the root node_modules so that
# Metro (used by expo prebuild / gradlew) can resolve them without a custom
# pnpm-aware resolver. Without this, pnpm only keeps them in the virtual
# store (.pnpm/) and Metro never finds them during a native build.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
