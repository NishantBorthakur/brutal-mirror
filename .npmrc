auto-install-peers=false
strict-peer-dependencies=false
confirm-modules-purge=false

# Hoist all packages to root node_modules.
# - Matches the hoistPattern: ['*'] recorded in node_modules/.modules.yaml,
#   so pnpm never sees a settings mismatch and never needs to purge node_modules
#   on the deployment build runner (which has no TTY).
# - Also gives Metro (expo prebuild / gradlew) broad package visibility without
#   needing a custom pnpm-aware resolver.
shamefully-hoist=true
