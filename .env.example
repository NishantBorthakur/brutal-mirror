# ── Supabase (required for auth + credits) ──────────────────
# Create a project at https://supabase.com and fill in these values.
# Run supabase/schema.sql in your Supabase SQL Editor before starting.

# Backend (server-side only — NEVER expose to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile / frontend (safe to bundle — anon key only)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── AI (auto-provisioned by Replit AI Integrations) ──────────
# These are set automatically when using Replit AI Integrations.
# Do not set manually unless running outside Replit.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
