# Auth and credits use Replit OIDC and PostgreSQL, not Supabase.
# DATABASE_URL and REPL_ID are provided by Replit; do not commit credentials.
# The mobile dev command derives EXPO_PUBLIC_DOMAIN and EXPO_PUBLIC_REPL_ID
# from Replit's runtime environment.

# ── AI (auto-provisioned by Replit AI Integrations) ──────────
# These are set automatically when using Replit AI Integrations.
# Do not set manually unless running outside Replit.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional credit purchases (server-side Secrets only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
